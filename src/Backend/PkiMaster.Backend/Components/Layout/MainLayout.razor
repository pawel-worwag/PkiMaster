@using PkiMaster.Backend.Components.Shared
@inherits LayoutComponentBase

<div class="container">
    <div class="d-flex my-4 justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <button class="btn btn-outline-secondary" @onclick="OpenMenuAsync"><span class="bi bi-list"></span></button>
            <span class="fs-3 ms-4">PkiMaster</span>
        </div>
        <UserDisplayComponent/>
    </div>
</div>

<div class="offcanvas offcanvas-start"
     tabindex="-1" @ref="_mainMenuElement">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="offcanvasMainMenuLabel">PkiMaster</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column">
        <MainMenu/>
    </div>
</div>

<div class="container my-3">
    @Body
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>