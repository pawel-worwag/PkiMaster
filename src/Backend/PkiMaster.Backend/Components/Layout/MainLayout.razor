@using PkiMaster.Backend.Components.Shared
@inherits LayoutComponentBase

<div class="container">
    <div class="d-flex my-4 justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <button class="btn btn-outline-secondary"><span class="bi bi-list"></span></button>
            <span class="fs-3 ms-4">PkiMaster</span>
        </div>
        <UserDisplayComponent/>
    </div>
</div>
<div class="container my-3">
    @Body
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>