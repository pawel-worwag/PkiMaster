@page "/profile"

<PageTitle>User profile</PageTitle>

<div class="container">
    <div class="px-4 py-5 my-5 text-center">
        <span class="bi bi-person-circle display-1"></span>
        <h1 class="display-5 fw-bold text-body-emphasis">@userDisplayName</h1>
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mt-5">
            <button type="button" class="btn btn-primary px-4 gap-3">Edit profile</button>
            <button type="button" class="btn btn-outline-secondary px-4">Change password</button>
        </div>
    </div>
    @if (_claims is not null && _claims.Any())
    {
        <table class="table table-striped table-hover m-auto">
            @foreach (var claim in _claims.Where(c => c.Type != "AspNet.Identity.SecurityStamp"))
            {
                <tr>
                    <td>@claim.Type:</td>
                    <td>@claim.Value</td>
                </tr>
            }
        </table>
    }
</div>