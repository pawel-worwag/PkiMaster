@page "/login"

<PageTitle>Sign in</PageTitle>

<div class="form-signin">
<h1>Sign in</h1>

@if (HasInvalidCredentialsError)
{
    <p class="validation-message">Invalid credentials.</p>
}

<form method="post" action="/account/login">
    <AntiforgeryToken />
    <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input class="form-control" id="email" name="Email" type="email" autocomplete="username" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input class="form-control" id="password" name="Password" type="password" autocomplete="current-password" required />
    </div>
    <div class="mb-3 form-check">
        <input class="form-check-input" id="rememberMe" name="RememberMe" type="checkbox" value="true" />
        <label class="form-check-label" for="rememberMe">Remember me</label>
    </div>
    <button class="btn btn-primary w-100 py-2" type="submit">Sign in</button>
</form>

</div>

@code {
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private bool HasInvalidCredentialsError =>
        NavigationManager.ToAbsoluteUri(NavigationManager.Uri).Query.Contains("error=invalid-credentials", StringComparison.OrdinalIgnoreCase);
}
